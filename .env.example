# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Used to build the OAuth redirect URL (http://localhost:3000 locally, the Vercel URL in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=gemini-flash-latest
# Optional: the Gemini model tried when the main one is overloaded (empty = none)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Optional backup when every Gemini model is overloaded (text features only; photos stay with Gemini).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Monitored inbox shown on /privacy and /terms (account deletion requests go here)
NEXT_PUBLIC_SUPPORT_EMAIL=
