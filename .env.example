# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Used to build the OAuth redirect URL (http://localhost:3000 locally, the Vercel URL in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=gemini-flash-latest
